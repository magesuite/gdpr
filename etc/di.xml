<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Sales\Model\Order">
        <plugin name="hide_customer_data" type="MageSuite\Gdpr\Plugin\Magento\Sales\Model\Order\HideCustomerData" sortOrder="10" />
    </type>

    <type name="Magento\Sales\Model\Order\Address">
        <plugin name="hide_customer_data" type="MageSuite\Gdpr\Plugin\Magento\Sales\Model\Order\Address\HideAddressData" sortOrder="10" />
    </type>

    <type name="Magento\Ui\Component\Listing">
        <plugin name="hide_customer_data" type="MageSuite\Gdpr\Plugin\Magento\Ui\Component\Listing\HideCustomerData" sortOrder="10" />
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <plugin name="hide_customer_data" type="MageSuite\Gdpr\Plugin\Magento\Framework\View\Element\UiComponent\DataProvider\Reporting\HideCustomerData" sortOrder="10" />
    </type>

    <type name="Magento\Sales\Block\Adminhtml\Order\Payment">
        <plugin name="hide_payment_information" type="MageSuite\Gdpr\Plugin\Magento\Sales\Block\Adminhtml\Order\Payment\HideCustomerData" sortOrder="10" />
    </type>

    <type name="Magento\Payment\Block\Info">
        <plugin name="hide_pdf_payment_information" type="MageSuite\Gdpr\Plugin\Magento\Payment\Block\Info\HideCustomerData" sortOrder="10" />
    </type>

    <type name="Magento\Customer\Controller\Adminhtml\Index\Edit">
        <plugin name="hide_customer_edit" type="MageSuite\Gdpr\Plugin\Magento\Customer\Controller\Adminhtml\Index\Edit\AccessDeniedPageOnCustomerEdit" sortOrder="10" />
    </type>

    <type name="Magento\Sales\Controller\Adminhtml\Order\Address">
        <plugin name="hide_address_edit" type="MageSuite\Gdpr\Plugin\Magento\Sales\Controller\Adminhtml\Order\Address\AccessDeniedPageOnAddressEdit" sortOrder="10" />
    </type>

    <type name="MageSuite\Gdpr\Plugin\Magento\Ui\Component\Listing\HideCustomerData">
        <arguments>
            <argument name="grids" xsi:type="array">
                <item name="sales" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Grid\SalesGridAnonymization</item>
                <item name="customer" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Grid\CustomerGridAnonymization</item>
                <item name="customer_online" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Grid\CustomerOnlineGridAnonymization</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\Gdpr\Plugin\Magento\Framework\View\Element\UiComponent\DataProvider\Reporting\HideCustomerData">
        <arguments>
            <argument name="grids" xsi:type="array">
                <item name="sales" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Export\SalesGridExportAnonymization</item>
                <item name="customer" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Export\CustomerGridExportAnonymization</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\Gdpr\Helper\CustomerDataVisibility">
        <arguments>
            <argument name="anonymizedActionsProviders" xsi:type="array">
                <item name="customer" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Actions\CustomerAction</item>
                <item name="mui" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Actions\MuiAction</item>
                <item name="order_shipment" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Actions\OrderShipmentAction</item>
                <item name="sales_order" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Actions\SalesOrderAction</item>
                <item name="sales_shipment" xsi:type="object">MageSuite\Gdpr\Model\HideCustomerData\Actions\SalesShipmentAction</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="MageSuite\Gdpr\Model\HideCustomerData\Actions\CustomerAction" type="MageSuite\Gdpr\Model\HideCustomerData\AbstractAnonymizedAction">
        <arguments>
            <argument name="anonymizedActions" xsi:type="array">
                <item name="customer_index_edit" xsi:type="string">customer_index_edit</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="MageSuite\Gdpr\Model\HideCustomerData\Actions\MuiAction" type="MageSuite\Gdpr\Model\HideCustomerData\AbstractAnonymizedAction">
        <arguments>
            <argument name="anonymizedActions" xsi:type="array">
                <item name="mui_index_render" xsi:type="string">mui_index_render</item>
                <item name="mui_export_gridToCsv" xsi:type="string">mui_export_gridToCsv</item>
                <item name="mui_export_gridToXml" xsi:type="string">mui_export_gridToXml</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="MageSuite\Gdpr\Model\HideCustomerData\Actions\OrderShipmentAction" type="MageSuite\Gdpr\Model\HideCustomerData\AbstractAnonymizedAction">
        <arguments>
            <argument name="anonymizedActions" xsi:type="array">
                <item name="adminhtml_order_shipment_new" xsi:type="string">adminhtml_order_shipment_new</item>
                <item name="adminhtml_order_shipment_view" xsi:type="string">adminhtml_order_shipment_view</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="MageSuite\Gdpr\Model\HideCustomerData\Actions\SalesOrderAction" type="MageSuite\Gdpr\Model\HideCustomerData\AbstractAnonymizedAction">
        <arguments>
            <argument name="anonymizedActions" xsi:type="array">
                <item name="sales_order_view" xsi:type="string">sales_order_view</item>
                <item name="sales_order_invoice_new" xsi:type="string">sales_order_invoice_new</item>
                <item name="sales_order_invoice_view" xsi:type="string">sales_order_invoice_view</item>
                <item name="sales_order_invoice_print" xsi:type="string">sales_order_invoice_print</item>
                <item name="sales_order_creditmemo_new" xsi:type="string">sales_order_creditmemo_new</item>
                <item name="sales_order_creditmemo_view" xsi:type="string">sales_order_creditmemo_view</item>
                <item name="sales_order_creditmemo_print" xsi:type="string">sales_order_creditmemo_print</item>
                <item name="sales_order_address" xsi:type="string">sales_order_address</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="MageSuite\Gdpr\Model\HideCustomerData\Actions\SalesShipmentAction" type="MageSuite\Gdpr\Model\HideCustomerData\AbstractAnonymizedAction">
        <arguments>
            <argument name="anonymizedActions" xsi:type="array">
                <item name="sales_shipment_print" xsi:type="string">sales_shipment_print</item>
            </argument>
        </arguments>
    </virtualType>
</config>
